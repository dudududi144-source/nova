# NOVA Environment Variables

# ═══════════════════════════════════════════
# LLM BACKENDS (at least one required)
# ═══════════════════════════════════════════

# Z.AI SDK — Primary LLM backend (pre-configured in Z.ai sandbox)
# For external deployment, get your key from Z.ai
# ZAI_API_KEY=

# DashScope (Qwen) — Secondary LLM backend
# Get your key at https://dashscope.aliyun.com
# DASHSCOPE_API_KEY=

# TokenRouter (Kimi K3) — Tertiary LLM backend
# Get your free key at https://tokenrouter.com
# TOKENROUTER_API_KEY=

# ═══════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════

# SQLite database path (for Prisma)
DATABASE_URL=file:/app/db/custom.db

# ═══════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════

# Port (default: 3000)
PORT=3000

# Environment
NODE_ENV=production

# ═══════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Allowed dev origins (for CORS in dev mode)
# ALLOWED_DEV_ORIGINS=https://your-domain.com
