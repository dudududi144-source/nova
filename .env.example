# NOVA Environment Variables

# Z.AI SDK — Primary LLM backend
# In the Z.ai sandbox, this is pre-configured. For local development, add your key.
# ZAI_API_KEY=

# TokenRouter — Kimi K3 (free, OpenAI-compatible)
# Get a free key at https://tokenrouter.com
# Used for: Kimi K3 model, critique pass, fallback
TOKENROUTER_API_KEY=your-key-here
