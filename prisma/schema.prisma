// Prisma schema for NOVA
// NOTE: NOVA v1 does not use a database. This schema exists for future use
// (e.g., server-persisted projects, user accounts). The DATABASE_URL in .env
// is only needed if you run `prisma db push` to set up the DB for future features.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
